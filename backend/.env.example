# Copy to .env (never commit .env). Local dev works without any of these.
# Production (Railway): set all of these in the service Variables tab.

# Public backend URL phones reach, e.g. https://aws-photobooth.up.railway.app
PUBLIC_BASE_URL=

# Frontend origin(s) allowed to call the API, comma-separated,
# e.g. https://aws-photobooth.vercel.app
FRONTEND_URL=

# Google Drive storage (service account JSON, single line). When set along
# with GDRIVE_FOLDER_ID, photos go to Drive; otherwise local uploads/ dir.
GOOGLE_SERVICE_ACCOUNT_JSON=
GDRIVE_FOLDER_ID=
