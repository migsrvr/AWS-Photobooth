# Copy to backend/.env (never commit .env). REQUIRED - no local fallback.
# Dashboard: https://ezcypksgixkdmrqirtcp.supabase.co -> Settings -> API
# Push migration: npx supabase link --project-ref ezcypksgixkdmrqirtcp && npx supabase db push

# Phones QR base - no trailing slash - e.g. https://<railway>.up.railway.app
PUBLIC_BASE_URL=
# CORS origin(s) - comma-separated, no trailing slash - e.g. https://<vercel>.vercel.app
FRONTEND_URL=

# Supabase - bucket `photobooth` (public) + table `survey_responses` - see supabase/migrations/*.sql
SUPABASE_URL=https://ezcypksgixkdmrqirtcp.supabase.co
SUPABASE_SERVICE_ROLE_KEY= # service_role (Settings -> API, never anon)
SUPABASE_BUCKET=photobooth

# Upload guards (MB). Photo is Pillow-compressed to JPEG q78 / max 1600px
# before upload; video is NOT transcoded (no ffmpeg) — size is capped at
# capture (frontend 960px / 24fps / 1Mbps) and enforced here.
MAX_PHOTO_MB=15
MAX_VIDEO_MB=8
PHOTO_MAX_DIM=1600
PHOTO_JPEG_QUALITY=78
