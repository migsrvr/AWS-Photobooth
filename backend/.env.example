# Copy to .env (never commit .env). Local dev works without any of these.
# Production (Railway): set these in the service Variables tab.

# Public backend URL phones reach, e.g. https://aws-photobooth.up.railway.app
PUBLIC_BASE_URL=

# Frontend origin(s) allowed to call the API, comma-separated,
# e.g. https://aws-photobooth.vercel.app
FRONTEND_URL=
